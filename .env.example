# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role Supabase — Dashboard Supabase > Project Settings > API >
# "service_role" (secret). ATTENTION : ne pas confondre avec la clé "anon" ;
# elle sert à contourner la RLS depuis les webhooks Grow (qui n'ont pas de
# session utilisateur). Vérifiez sa valeur : le payload du JWT doit contenir
# "role":"service_role", pas "role":"anon".
SUPABASE_SERVICE_ROLE_KEY=

# Grow (ex-Meshulam) — paiement en ligne
#
# Toutes ces valeurs sont propres à votre compte Grow et doivent être
# obtenues auprès du support Grow (support@grow.business) avant de pouvoir
# tester quoi que ce soit, même en sandbox.
#
# "sandbox" ou "production" — bascule l'URL de base de l'API Grow.
GROW_ENV=sandbox
# Identifiant de votre entreprise chez Grow (fourni par leur support).
GROW_USER_ID=
# pageCode de la page de paiement "générique" (carte + Bit) — obligatoire.
GROW_PAGE_CODE_CARD_BIT=
# pageCode dédiés Google Pay / Apple Pay — optionnels : sans eux, ces deux
# boutons retombent sur la page générique carte+Bit (voir lib/grow.ts,
# pageCodeFor()). Apple Pay nécessite en plus une vérification de domaine
# fournie par Grow avant de fonctionner en iframe.
GROW_PAGE_CODE_GOOGLE_PAY=
GROW_PAGE_CODE_APPLE_PAY=
